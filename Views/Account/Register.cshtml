@model PENANO.Models.RegisterViewModel



<section class="page-section" id="register" style="padding-top: 12rem;">
    <div class="container">
        <h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">Register</h2>

        <div class="divider-custom">
            <div class="divider-custom-line"></div>
            <div class="divider-custom-icon"><i class="fas fa-star"></i></div>
            <div class="divider-custom-line"></div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">

                <div id="alertContainer"></div>

                <form asp-action="Register" method="post" id="registerForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Username" id="Username" class="form-control" placeholder="Enter your username..." />
                        <label asp-for="Username"></label>
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" id="Email" type="email" class="form-control" placeholder="Enter your email..." />
                        <label asp-for="Email"></label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" id="Password" type="password" class="form-control" placeholder="Enter your password..." />
                        <label asp-for="Password"></label>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-flex align-items-center gap-3 mt-4">
                        <button type="submit" class="btn btn-theme btn-xl">Submit</button>

                        <a href="/Account/Login" class="text-theme-link">Need an account? Register</a>

                    </div>
                </form>

            </div>
        </div>
    </div>
</section>

@* modal *@
<div id="manualModal" class="custom-modal-overlay">
    <div class="custom-modal-card">
        <div class="custom-modal-header">
            <div id="manualModalIcon" class="custom-modal-icon success">
                <i class="fas fa-check-circle"></i>
            </div>
        </div>

        <div class="custom-modal-body">
            <h3 id="manualModalTitle" class="custom-modal-title">Success!</h3>
            <p id="manualModalMessage" class="custom-modal-message">Your operation was completed successfully.</p>
        </div>

        <div class="custom-modal-footer">
            <button id="manualModalBtn" class="custom-modal-btn">Continue</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/utils.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {
            $("#registerForm").on("submit", function (e) {
                e.preventDefault();

                $.ajax({
                    url: '/Register',
                    method: 'POST',
                    data: {
                        "Username": $("#Username").val(),
                        "Email": $("#Email").val(),
                        "Password": $("#Password").val()
                    },

                    success: function (response) {

                        console.log(response);
                        alert(`SQL INSERTED QUERY: ${response.message}`);


                        showManualModal(
                            response.success ? 'Success!' : 'Registration Failed',
                            response.message,
                            response.success,
                             null
                        );
                    }
                });
            });
        });
    </script>
}