@model PENANO.Models.User
@{
    ViewData["Title"] = "Create Account";
}

<div class="d-flex flex-column min-vh-100" style="padding-top: 10rem;">
    <div class="card p-4 shadow-lg border-0 dynamic-form-card mx-auto" style="width: 100%; max-width: 420px; border-radius: 16px; background: #ffffff;">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-dark mb-1">Create Account</h2>
            <p class="text-muted small">Join us and manage your creative hub</p>
        </div>

        <form asp-controller="Home" asp-action="Register" method="post" autocomplete="off" id="registerForm">
            @Html.AntiForgeryToken()

            <!-- Global Error Alert -->
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
            {
                <div class="alert alert-danger py-2 small" role="alert">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger list-unstyled m-0" })
                </div>
            }

            <!-- Name Input Field -->
            <div class="form-floating mb-3">
                <input asp-for="Name" class="form-control" placeholder="Full Name" style="border-radius: 10px;" />
                <label asp-for="Name">Full Name</label>
                <span asp-validation-for="Name" class="text-danger small px-1"></span>
            </div>

            <!-- Email Input Field -->
            <div class="form-floating mb-3">
                <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" style="border-radius: 10px;" />
                <label asp-for="Email">Email Address</label>
                <span asp-validation-for="Email" class="text-danger small px-1"></span>
            </div>

            <!-- Password Input Field -->
            <div class="form-floating mb-4">
                <input asp-for="Password" type="password" class="form-control" placeholder="Password" style="border-radius: 10px;" />
                <label asp-for="Password">Password</label>
                <span asp-validation-for="Password" class="text-danger small px-1"></span>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-warning w-100 py-3 fw-semibold mb-3 text-white shadow-sm" style="border-radius: 10px; background-color: #ffc107; border: none;">
                Sign Up
            </button>

            <!-- Redirect Link -->
            <div class="text-center mt-2">
                <span class="text-muted small">Already have an account? </span>
                <a asp-controller="Home" asp-action="Login" class="text-warning small fw-bold text-decoration-none">Sign In</a>
            </div>
        </form>
    </div>
</div>

         


@section Scripts {
    <!-- 1. Import jQuery CDN (If it's not already in your shared _Layout.cshtml) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- 2. Import your custom external JavaScript file -->
    <script src="~/js/auth.js" asp-append-version="true"></script>
}